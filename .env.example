APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
# Демо-аккаунты (ученик/учитель/админ) создаются только при ENABLE_DEMO_DATA=true
# и полном наборе DEMO_* — см. README.md «Тестовые данные».
ENABLE_DEMO_DATA=false
# Generate via `openssl rand -hex 32`. Production validator requires >=32 chars
# without placeholder fragments (change-me / replace-me / example / dev-secret / etc).
SECRET_KEY=replace-with-a-long-random-development-secret-please-rotate
JWT_SIGNING_KEY_ID=default
# Optional rotation keyring. Format: current=64hex,previous=64hex
# JWT_SIGNING_KEYS=default=replace-with-a-long-random-development-secret
# DATABASE_URL overrides POSTGRES_* below. Leave unset in docker compose to use POSTGRES_PASSWORD_FILE.
# DATABASE_URL=postgresql+psycopg://codequest:strong-password@db:5432/codequest
# For docker compose use DATABASE_URL_OVERRIDE only when you intentionally bypass POSTGRES_PASSWORD_FILE.
# DATABASE_URL_OVERRIDE=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=codequest
POSTGRES_USER=codequest
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
ACCESS_TOKEN_MINUTES=30
# docker-compose overrides legacy .env values with ACCESS_TOKEN_MINUTES_OVERRIDE when set.
# ACCESS_TOKEN_MINUTES_OVERRIDE=30
REFRESH_TOKEN_DAYS=14
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Strict
# В development при первом `bootstrap-app` создаётся суперадмин; без этого и без DEMO
# в БД нет учёток админа — вход даст «Неверный логин или пароль».
# В production выставьте false и задайте сильные значения.
SUPERADMIN_BOOTSTRAP=true
SUPERADMIN_NAME=Главный администратор
SUPERADMIN_EMAIL=superadmin@codequest.local
# Replace before any non-local run. Production validator requires >=12 chars + complexity.
SUPERADMIN_PASSWORD=ReplaceMe-Local-SuperAdmin-1!
INTERNAL_API_URL=http://localhost:8000/api
# Турнир (Next.js /app/tournament): интервал перезагрузки XLSX с Yandex Disk, в секундах.
# Пример: 300 = 5 мин, 3600 = 1 ч. 0 = без кэша (каждый запрос — новая загрузка файла).
TOURNAMENT_DATA_REFRESH_INTERVAL_SECONDS=1200
# Docker secrets: скопируйте secrets/redis_password.example → secrets/redis_password
# и secrets/postgres_password.example → secrets/postgres_password для локального compose.
# REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
THROTTLE_BACKEND=dual
# SESSION_VERSION_CACHE=off
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REGISTER_RATE_LIMIT_MAX_FAILURES=25
REGISTER_RATE_LIMIT_BLOCK_SECONDS=3600
REGISTER_IP_RATE_LIMIT_WINDOW_SECONDS=3600
REGISTER_IP_RATE_LIMIT_MAX_ATTEMPTS=30
REGISTER_IP_RATE_LIMIT_BLOCK_SECONDS=3600
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT_MAX_FAILURES=45
REFRESH_RATE_LIMIT_BLOCK_SECONDS=300
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_FAILURES=8
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
PARENT_ACCESS_RATE_LIMIT_WINDOW_SECONDS=600
PARENT_ACCESS_RATE_LIMIT_MAX_FAILURES=20
PARENT_ACCESS_RATE_LIMIT_BLOCK_SECONDS=900
CODE_JUDGE_PYTHON_BIN=python
CODE_JUDGE_NODE_BIN=node
CODE_JUDGE_RUNNER_URL=http://localhost:8090/execute
CODE_JUDGE_DEFAULT_TIME_LIMIT_MS=2000
CODE_JUDGE_DEFAULT_MEMORY_LIMIT_MB=128
CODE_JUDGE_MAX_OUTPUT_CHARS=4000
CODE_JUDGE_RUNNER_TIMEOUT_MS=15000
# Mandatory: docker-compose now refuses to start without this. >=32 random chars.
# Generate via `openssl rand -hex 32`. CODE_JUDGE_RUNNER_TOKEN must equal this value
# (compose wires them together) — backend uses it to authenticate to judge-runner.
JUDGE_RUNNER_AUTH_TOKEN=replace-me-change-me-with-32plus-random-chars-runner-token
JUDGE_RUNNER_MAX_CONCURRENCY=4
JUDGE_RUNNER_MAX_TEST_CONCURRENCY=4
CODE_JUDGE_RUNNER_TOKEN=replace-me-change-me-with-32plus-random-chars-runner-token

# Production example:
# APP_ENV=production
# NEXT_PUBLIC_APP_ENV=production
# CLIENT_URL=https://your-frontend-domain.example
# NEXT_PUBLIC_API_URL=https://your-frontend-domain.example/api
# INTERNAL_API_URL=http://backend:8000/api

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_TIMEOUT_MS=30000
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=

# Transactional email (Unisender Go)
# Get an API key in: Unisender Go → Settings → API access. The endpoint host depends
# on the data centre your account lives in (RU1/USA1/EU1). See docs/email_unisender_go.md
EMAIL_PROVIDER=unisender_go
UNISENDER_GO_API_KEY=
UNISENDER_GO_API_URL=https://go1.unisender.ru/ru/transactional/api/v1
UNISENDER_GO_TIMEOUT_MS=15000
EMAIL_FROM=no-reply@progyx.local
EMAIL_FROM_NAME=Progyx
EMAIL_REPLY_TO=
# Public frontend origin used to build verify/reset URLs in emails
FRONTEND_PUBLIC_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Set to false for local/dev: no outgoing mail, new accounts skip email verification
# (see /api/auth/register). Password reset / resend still "succeed" without delivery.
SEND_MAIL=true
# Set to true on local/staging to skip real API calls and only log payloads
EMAIL_DRY_RUN=false
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5
PASSWORD_RESET_RATE_LIMIT_BLOCK_SECONDS=3600
RESEND_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=3600
RESEND_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=5
RESEND_VERIFICATION_RATE_LIMIT_BLOCK_SECONDS=3600
